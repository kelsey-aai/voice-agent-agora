# AssemblyAI Voice Agent API key — https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# Agora project credentials — https://console.agora.io
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Channel the bot joins (must match the channel your end users connect to)
AGORA_CHANNEL=voice-agent-demo

# UID the bot publishes under inside the Agora channel
AGORA_BOT_UID=9999
