# AssemblyAI API key: one key covers speech-to-text, LLM Gateway, and text-to-speech
# https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Agora project App ID: https://console.agora.io
AGORA_APP_ID=your_agora_app_id
# Leave empty if your Agora project has App Certificate disabled
AGORA_TOKEN=

# Channel the bot joins (must match the channel your users connect to)
AGORA_CHANNEL=voice-agent-demo

# UID the bot joins and publishes under inside the Agora channel
AGORA_BOT_UID=9999
